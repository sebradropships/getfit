# Your myshopify domain — NOT a custom domain.
SHOPIFY_STORE_DOMAIN=vfuvr4-df.myshopify.com

# Public Storefront API access token from the Headless channel.
# This token is read-only and safe to expose to a browser, but keep it out
# of git anyway. Set the real value in .env.local and in Vercel env vars.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Meta Pixel / dataset id. Public by design — it ships inside the page.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token. SECRET.
# Events Manager -> the dataset -> Settings -> Conversions API ->
# "Generate access token".
META_CAPI_ACCESS_TOKEN=

# Signing secret Shopify shows when you create the orders/paid webhook. SECRET.
# Without it the webhook route answers 503 and Shopify keeps retrying.
SHOPIFY_WEBHOOK_SECRET=

# Optional, and TEMPORARY. Set it only while confirming the route in
# Events Manager -> Test events, then delete it — while it is set, real
# purchases land in test data instead of production.
META_CAPI_TEST_EVENT_CODE=

# Optional. Overrides the dataset the SERVER posts to, if it ever has to
# differ from NEXT_PUBLIC_META_PIXEL_ID. Normally leave empty.
META_DATASET_ID=

# Optional. event_source_url on server events. Defaults to https://viraltoys.us/
SITE_URL=
